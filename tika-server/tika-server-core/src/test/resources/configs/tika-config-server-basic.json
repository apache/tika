// TIKA-4834: keep these comments; TikaServerBasicIntegrationTest is the check that the
// server and its forks load a commented config.
{
  /* block comment before a key */
  "server": {
    "port": 9999, // trailing comment
    "allowPipes": true,
    "allowPerRequestConfig": true,
    "endpoints": [
      "rmeta",
      // comment inside an array
      "status",
      "tika"
    ]
  },
  "parse-context": {
    "timeout-limits": {
      "progressTimeoutMillis": 120000
    }
  },
  "pipes": {
    "numClients": 2,
    "forkedJvmArgs": [
      "-Xmx256m"
    ]
  },
  "plugin-roots": "target/plugins"
}
