{
  "server": {
    "port": 9999,
    "allowPipes": true,
    "endpoints": [
      "rmeta"
    ]
  },
  "parse-context": {
    "timeout-limits": {
      "progressTimeoutMillis": 5000
    }
  },
  "pipes": {
