{
  // Render each PDF page as an image and run Tesseract on it.
  // ocr.strategy options: no_ocr, ocr_only, ocr_and_text_extraction, auto.
  "text-recognizers": [
    { "tesseract-ocr-parser": {} }
  ],
  "parsers": [
    { "default-parser": {} },
    {
      "pdf-parser": {
        "ocr": {
          "strategy": "ocr_only",
          "imageType": "rgb",
          "dpi": 100
        }
      }
    }
  ]
}
