{
  // Vision-Language Model OCR via Anthropic's Claude API: every default parser
  // stays loaded, and embedded images and rendered PDF pages go to Claude when
  // the "pages" block's "text" policy asks for OCR (AUTO by default).
  // Set apiKey to your Anthropic API key — DO NOT commit a real key.
  // Prefer passing it via the ANTHROPIC_API_KEY env var and substituting it
  // at container start, e.g. via an entrypoint shim or sidecar that templates
  // this file. See docs: configuration/parsers/vlm-parsers.
  "engines": {
    "claude": {
      "claude-vlm-parser": {
        "apiKey": "${ANTHROPIC_API_KEY}",
        "model": "claude-sonnet-4-20250514"
      }
    }
  },
  "text-recognizers": [ { "engine": "claude" } ]
}
