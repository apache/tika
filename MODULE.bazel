module(name = "tika")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.2")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# Versions come from tika-parent: explicit ones from its <dependencyManagement>, the rest
# from the BOMs it imports. The Maven resolver gives Maven's nearest-wins conflict rules.
# Re-pin after editing: REPIN=1 bazel run @maven//:pin
maven.install(
    artifacts = [
        "com.drewnoakes:metadata-extractor:2.22.0",
        "com.epam:parso:2.0.14",
        "com.fasterxml.jackson.core:jackson-core",
        "com.fasterxml.jackson.core:jackson-databind",
        "com.fasterxml.jackson.dataformat:jackson-dataformat-smile",
        "com.github.jai-imageio:jai-imageio-core:1.4.0",
        "com.github.jai-imageio:jai-imageio-jpeg2000:1.4.0",
        "com.github.junrar:junrar:8.1.2",
        "com.github.luben:zstd-jni:1.5.7-25",
        "com.google.guava:guava:33.8.0-jre",
        "com.googlecode.plist:dd-plist:1.30",
        "com.healthmarketscience.jackcess:jackcess:5.0.4",
        "com.martensigwart:fakeload:0.7.0",
        "com.pff:java-libpst:0.9.3",
        "com.rometools:rome:2.1.0",
        "commons-codec:commons-codec:1.23.0",
        "commons-io:commons-io:2.22.0",
        "commons-logging:commons-logging:1.4.0",
        "org.apache.commons:commons-collections4:4.6.0",
        "org.apache.commons:commons-compress:1.28.0",
        "org.apache.commons:commons-csv:1.14.1",
        "org.apache.commons:commons-exec:1.6.0",
        "org.apache.commons:commons-lang3:3.21.0",
        "org.apache.commons:commons-secure-xml:1.1.0",
        "org.apache.james:apache-mime4j-core:0.8.15",
        "org.apache.james:apache-mime4j-dom:0.8.15",
        "org.apache.logging.log4j:log4j-slf4j2-impl",
        "org.apache.pdfbox:fontbox:3.0.8",
        "org.apache.pdfbox:jbig2-imageio:3.0.5",
        "org.apache.pdfbox:pdfbox:3.0.8",
        "org.apache.poi:poi:6.0.0",
        "org.apache.poi:poi-scratchpad:6.0.0",
        "org.bouncycastle:bcjmail-jdk18on",
        "org.bouncycastle:bcprov-jdk18on",
        "org.brotli:dec:0.1.2",
        "org.codelibs:jhighlight:2.0.0",
        "org.commonmark:commonmark:0.32.0",
        "org.commonmark:commonmark-ext-gfm-strikethrough:0.32.0",
        "org.commonmark:commonmark-ext-gfm-tables:0.32.0",
        "org.gagravarr:vorbis-java-core:0.10",
        "org.jsoup:jsoup:1.24.1",
        "org.junit.jupiter:junit-jupiter",
        "org.junit.jupiter:junit-jupiter-api:6.1.3",
        "org.junit.jupiter:junit-jupiter-engine:6.1.3",
        "org.junit.jupiter:junit-jupiter-params",
        "org.junit.platform:junit-platform-launcher",
        "org.junit.platform:junit-platform-reporting",
        "org.mockito:mockito-core:5.24.0",
        "org.netpreserve:jwarc:0.37.0",
        "org.osgi:org.osgi.compendium:5.0.0",
        "org.osgi:org.osgi.core:6.0.0",
        "org.ow2.asm:asm:9.11.1",
        "org.pf4j:pf4j:3.16.1",
        "org.slf4j:jcl-over-slf4j",
        "org.slf4j:slf4j-api",
        "org.tallison:jmatio:1.5",
        "org.tukaani:xz:1.12",
    ],
    boms = [
        "com.fasterxml.jackson:jackson-bom:2.22.4",
        "org.apache.logging.log4j:log4j-bom:2.26.1",
        "org.bouncycastle:bc-jdk18on-bom:1.86.2",
        "org.junit:junit-bom:6.1.3",
        "org.slf4j:slf4j-bom:2.0.20",
    ],
    # tika-parent's enforcer bans these: Tika must work with the JDK's JAXP.
    excluded_artifacts = [
        "xerces:xercesImpl",
        "xml-apis:xml-apis",
    ],
    fail_if_repin_required = True,
    known_contributing_modules = ["protobuf"],
    lock_file = "//:maven_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    resolver = "maven",
)

# Per-dependency <exclusions> from the module POMs.
maven.artifact(
    artifact = "poi-ooxml",
    exclusions = ["org.apache.poi:poi-ooxml-lite"],
    group = "org.apache.poi",
    version = "6.0.0",
)
maven.artifact(
    artifact = "jackcess-encrypt",
    exclusions = [
        "com.healthmarketscience.jackcess:jackcess",
        "org.bouncycastle:bcprov-jdk18on",
    ],
    group = "com.healthmarketscience.jackcess",
    version = "5.0.2",
)
maven.artifact(
    artifact = "pdfbox-tools",
    exclusions = ["org.apache.pdfbox:pdfbox-debugger"],
    group = "org.apache.pdfbox",
    version = "3.0.8",
)
maven.artifact(
    artifact = "log4j-core",
    exclusions = ["org.osgi:org.osgi.core"],
    group = "org.apache.logging.log4j",
    version = "2.26.1",
)

# tika-core runs XmlSecurityContractTest a second time with standalone Xerces. Maven copies
# these jars aside instead of declaring them; a separate repository keeps them out of @maven.
maven.install(
    name = "xml_providers",
    artifacts = [
        "xerces:xercesImpl:2.12.2",
        "xml-apis:xml-apis:2.0.2",
    ],
    lock_file = "//:xml_providers_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    resolver = "maven",
)
# Code generators that Maven runs as plugins. Kept out of @maven so they never reach a
# library's classpath.
maven.install(
    name = "build_tools",
    artifacts = ["de.jflex:jflex:1.9.1"],
    lock_file = "//:build_tools_install.json",
    repositories = ["https://repo1.maven.org/maven2"],
    resolver = "maven",
)
use_repo(maven, "build_tools", "maven", "xml_providers")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# Mozilla Readability's conformance pages for tika-readability's UpstreamTestPagesTest. Maven
# downloads the same commit with download-maven-plugin (readability.upstream.sha/.sha512).
http_archive(
    name = "readability_upstream",
    build_file_content = """filegroup(
    name = "test_pages",
    srcs = glob(["test/test-pages/**"]),
    visibility = ["//visibility:public"],
)
""",
    integrity = "sha512-A9ExpxXOg97x0xQrXJlG2gqS+Z+YIDbK8DhY4msTG51zUmsp5lOgw5vpaTxHNer1IiMMiZD2jUCdU+VuDrwH6w==",
    strip_prefix = "readability-ab4027a8b37669745016869a37a504727992b2ba",
    type = "tar.gz",
    urls = ["https://codeload.github.com/mozilla/readability/tar.gz/ab4027a8b37669745016869a37a504727992b2ba"],
)
