 "tika-parser-microsoft-module": {
  "append": "# jflex-maven-plugin: generate the RTF lexer from src/main/jflex.\ngenrule(\n    name = \"rtf_tokenizer\",\n    srcs = [\"src/main/jflex/org/apache/tika/parser/microsoft/rtf/jflex/RTFTokenizer.jflex\"],\n    outs = [\"RTFTokenizer.java\"],\n    cmd = \"$(execpath //bazel:jflex) -q --nobak -d $(@D) $<\",\n    tools = [\"//bazel:jflex\"],\n)\n",
  "deps": [
   "@maven//:commons_io_commons_io",
   "@maven//:org_apache_commons_commons_compress"
  ],
  "extra": {
   "extra_srcs": [
    ":rtf_tokenizer"
   ]
  },
  "test_deps": [
   "@maven//:org_apache_logging_log4j_log4j_api",
   "@maven//:org_jsoup_jsoup"
  ]
 },
