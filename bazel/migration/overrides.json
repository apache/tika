 "tika-plugins-core": {
  "append": "# pf4j ships its processor with a META-INF/services entry, so Maven's javac finds it on the\n# classpath and writes META-INF/extensions.idx. Bazel runs only processors named as plugins.\njava_plugin(\n    name = \"pf4j_extension_processor\",\n    processor_class = \"org.pf4j.processor.ExtensionAnnotationProcessor\",\n    deps = [\"@maven//:org_pf4j_pf4j\"],\n)\n",
  "deps": [
   "@maven//:com_fasterxml_jackson_core_jackson_core",
   "@maven//:org_slf4j_slf4j_api"
  ],
  "extra": {
   "plugins": [
    ":pf4j_extension_processor"
   ]
  }
 },
 "tika-readability": {
  "extra": {
   "test_data": [
    "@readability_upstream//:test_pages"
   ]
  },
  "test_jvm_flags": [
   "-Dreadability.testPages=../+http_archive+readability_upstream/test/test-pages"
  ]
 },
 "tika-serialization": {
