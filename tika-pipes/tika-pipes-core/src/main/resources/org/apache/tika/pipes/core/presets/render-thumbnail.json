{
  // the same first-page and EMF/WMF renders as "thumbnail", added to a full parse. This "pages"
  // replaces the config's "parse-context" one, like any parse-context layer; a parser's own
  // "pages" under the config's "parsers" block still overlays it
  "pages": {
    "emit": {"enabled": true, "maxPages": 1,
             "render": {"maxWidth": 256, "maxHeight": 256, "imageType": "RGB"}}
  },
  "emf-parser": {"pages": {"emit": {"resourceTypes": ["THUMBNAIL"]}}},
  "wmf-parser": {"pages": {"emit": {"resourceTypes": ["THUMBNAIL"]}}}
}
