load("@rules_java//java:defs.bzl", "java_plugin")
load("//bazel:tika.bzl", "tika_java_module")

tika_java_module(
    name = "tika-plugins-core",
    deps = [
        "//tika-core",
        "//tika-serialization",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:org_pf4j_pf4j",
        "@maven//:org_slf4j_slf4j_api",
    ],
    test_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
        "@maven//:org_mockito_mockito_core",
    ],
    plugins = [":pf4j_extension_processor"],
)

# pf4j ships its processor with a META-INF/services entry, so Maven's javac finds it on the
# classpath and writes META-INF/extensions.idx. Bazel runs only processors named as plugins.
java_plugin(
    name = "pf4j_extension_processor",
    processor_class = "org.pf4j.processor.ExtensionAnnotationProcessor",
    deps = ["@maven//:org_pf4j_pf4j"],
)
