# Java 17, as maven.compiler.release in tika-parent. Compile and run on the hermetic
# remote JDK, so neither a local nor a remote-worker JDK is needed.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_17
common --tool_java_runtime_version=remotejdk_17

# Bazel's Java toolchain runs Error Prone and fails on some of its checks; Maven runs
# plain javac. Turn the checks off to match the Maven build.
build --javacopt=-XepDisableAllChecks

test --test_output=errors
test --test_verbose_timeout_warnings

# Machine-specific settings (remote execution, credentials) live here, not in git.
try-import %workspace%/user.bazelrc
