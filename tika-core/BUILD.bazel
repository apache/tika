    test_deps = [
        "@maven//:com_google_guava_guava",
        "@maven//:com_martensigwart_fakeload",
        "@maven//:org_apache_logging_log4j_log4j_core",
        "@maven//:org_apache_logging_log4j_log4j_slf4j2_impl",
        "@maven//:org_jspecify_jspecify",
