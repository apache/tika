<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>tika-parsers-ml</artifactId>
        <groupId>org.apache.tika</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>tika-parser-nlp-module</artifactId>
    <name>Apache Tika natural language process module</name>


    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>tika-parser-pdf-module</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Apache cTAKES -->
        <dependency>
            <groupId>org.apache.ctakes</groupId>
            <artifactId>ctakes-core</artifactId>
            <version>${ctakes.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-context</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-beans</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>log4j</groupId>
                    <artifactId>log4j</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>xerces</groupId>
                    <artifactId>xercesImpl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.google.guava</groupId>
                    <artifactId>guava</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.github.openjson</groupId>
            <artifactId>openjson</artifactId>
            <version>${openjson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.cxf</groupId>
            <artifactId>cxf-rt-rs-client</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpcore</artifactId>
        </dependency>
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>log4j-over-slf4j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
    <!-- TIKA-4816 metadata string-key ban, main sources; see tika-parent -->
    <forbiddenapis.module.signaturesFile>${metadata.forbiddenapis.signaturesFile}</forbiddenapis.module.signaturesFile>
    <opennlp.models.url>https://opennlp.sourceforge.net/models-1.5</opennlp.models.url>
  </properties>

  <build>
        <plugins>
            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <configuration>
                    <inputExcludes>
                        <inputExclude>src/test/resources/org/apache/tika/parser/ner/opennlp/*.bin</inputExclude>
                        <inputExclude>src/test/resources/test-documents/testJournalParser.pdf</inputExclude>
                    </inputExcludes>
                </configuration>
            </plugin>
            <!-- OpenNLP NER models for NamedEntityParserTest. Best effort: a failed download
                 or checksum mismatch only warns, and the tests that need the models skip. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>opennlp-models</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                                <property name="cache" value="${settings.localRepository}/.cache/tika-opennlp-models"/>
                                <mkdir dir="${cache}"/>
                                <macrodef name="model">
                                    <attribute name="name"/>
                                    <attribute name="sha256"/>
                                    <sequential>
                                        <local name="present"/>
                                        <local name="verified"/>
                                        <get src="${opennlp.models.url}/en-ner-@{name}.bin" dest="${cache}/en-ner-@{name}.bin"
                                             skipexisting="true" ignoreerrors="true" retries="3"/>
                                        <available file="${cache}/en-ner-@{name}.bin" property="present"/>
                                        <checksum if:set="present" file="${cache}/en-ner-@{name}.bin" algorithm="SHA-256"
                                                  property="@{sha256}" verifyproperty="verified"/>
                                        <!-- overwrite: testResources may already have copied a stale
                                             src/test/resources copy left behind by the old ModelGetter -->
                                        <copy if:true="${verified}" file="${cache}/en-ner-@{name}.bin" overwrite="true"
                                              tofile="${project.build.testOutputDirectory}/org/apache/tika/parser/ner/opennlp/ner-@{name}.bin"/>
                                        <echo unless:true="${verified}" level="warning"
                                              message="OpenNLP model en-ner-@{name}.bin unavailable or corrupt; NER tests will skip"/>
                                        <delete unless:true="${verified}" file="${cache}/en-ner-@{name}.bin" quiet="true"/>
                                    </sequential>
                                </macrodef>
                                <model name="person" sha256="687a9263d96b37fced707c9f2ac0560f9edaf54658856395555901924f64dbe4"/>
                                <model name="location" sha256="8fe39e48633f4a86c4132d9c54b396a2d8e0460c1d71e3562dacf976984f447b"/>
                                <model name="organization" sha256="0136c12afe1ac357142260c39bb879b7c9d121e41024114db5a6455b4fd5ba00"/>
                                <model name="date" sha256="1207030923852e1c244919d8f15d9e78c217323728fcf909029abd1703967855"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
  <scm>
    <tag>4.1.0-rc1</tag>
  </scm>
</project>