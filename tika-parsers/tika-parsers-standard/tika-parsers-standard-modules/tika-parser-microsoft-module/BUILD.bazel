load("//bazel:tika.bzl", "tika_java_module")

tika_java_module(
    name = "tika-parser-microsoft-module",
    deps = [
        "//tika-annotation-processor",
        "//tika-core",
        "//tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-html-module",
        "//tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-text-module",
        "//tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-xml-module",
        "//tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-zip-commons",
        "@maven//:com_healthmarketscience_jackcess_jackcess",
        "@maven//:com_healthmarketscience_jackcess_jackcess_encrypt",
        "@maven//:com_pff_java_libpst",
        "@maven//:commons_codec_commons_codec",
        "@maven//:commons_io_commons_io",
        "@maven//:commons_logging_commons_logging",
        "@maven//:org_apache_commons_commons_compress",
        "@maven//:org_apache_commons_commons_lang3",
        "@maven//:org_apache_james_apache_mime4j_core",
        "@maven//:org_apache_james_apache_mime4j_dom",
        "@maven//:org_apache_poi_poi",
        "@maven//:org_apache_poi_poi_ooxml",
        "@maven//:org_apache_poi_poi_scratchpad",
        "@maven//:org_bouncycastle_bcjmail_jdk18on",
        "@maven//:org_bouncycastle_bcprov_jdk18on",
        "@maven//:org_slf4j_slf4j_api",
    ],
    test_deps = [
        "//tika-core:tests",
        "//tika-encoding-detectors/tika-encoding-detector-html",
        "//tika-encoding-detectors/tika-encoding-detector-mojibuster",
        "//tika-ml/tika-ml-junkdetect",
        "//tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-mail-module",
        "//tika-serialization",
        "@maven//:org_apache_logging_log4j_log4j_api",
        "@maven//:org_apache_logging_log4j_log4j_core",
        "@maven//:org_apache_logging_log4j_log4j_slf4j2_impl",
        "@maven//:org_jsoup_jsoup",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_jupiter_junit_jupiter_params",
    ],
    test_excludes = ["src/test/java/org/apache/tika/parser/microsoft/AbstractPOIContainerExtractionTest.java"],
    extra_srcs = [":rtf_tokenizer"],
)

# jflex-maven-plugin: generate the RTF lexer from src/main/jflex.
genrule(
    name = "rtf_tokenizer",
    srcs = ["src/main/jflex/org/apache/tika/parser/microsoft/rtf/jflex/RTFTokenizer.jflex"],
    outs = ["RTFTokenizer.java"],
    cmd = "$(execpath //bazel:jflex) -q --nobak -d $(@D) $<",
    tools = ["//bazel:jflex"],
)
