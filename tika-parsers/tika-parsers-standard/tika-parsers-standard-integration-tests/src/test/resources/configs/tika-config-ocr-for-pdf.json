{
  "parsers": [
    {
      "default-parser": {}
    },
    {
      "pdf-parser": {
        "extractInlineImages": false,
        "ocr": {
          "strategy": "OCR_ONLY"
        }
      }
    }
  ],
  "engines": {
    "tesseract": {
      "tesseract-ocr-parser": {
        "maxFileSizeToOcr": 100
      }
    }
  },
  "text-recognizers": [
    {
      "engine": "tesseract"
    }
  ]
}
